# Copy to .env and fill in. Never commit .env.

# Long random string for signing login tokens
PL_JWT_SECRET=replace-with-a-long-random-string

# Encryption key for stored PDFs and pickup codes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PL_FILE_KEY=

# First admin account (created on first start if no admin exists)
PL_ADMIN_EMAIL=admin@example.com
PL_ADMIN_PASSWORD=change-this-password

# Local run without Docker uses SQLite by default:
# PL_DATABASE_URL=sqlite:///./printlocker.db
# PL_STORAGE_DIR=./data/pdfs

PL_PICKUP_HOURS=24
PL_MAX_PDF_MB=50
PL_MAX_SHEETS_PER_JOB=2000
PL_CORS_ORIGINS=*
